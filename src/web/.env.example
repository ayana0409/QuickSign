# Server-side BFF target for .NET Management Service (used by Next.js Route Handlers)
DOTNET_API_URL=http://localhost:5001/api/v1

# Client-side target for .NET Management Service
NEXT_PUBLIC_DOTNET_API_URL=http://localhost:5001/api/v1

# Client-side target for Go Crypto Engine
NEXT_PUBLIC_GO_CRYPTO_API_URL=http://localhost:50052/api/v1

# Public Web Portal URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
