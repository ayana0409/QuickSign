{
    "swagger": "2.0",
    "info": {
        "description": "Go Crypto Engine — HTTP REST API for PDF/JSON signing (PAdES \u0026 JWS) and document verification.\nSupports dual authentication: JWT Bearer (Web Portal) and X-API-Key (third-party integrations).",
        "title": "QuickSign Crypto Engine API",
        "contact": {
            "name": "QuickSign Engineering",
            "url": "https://github.com/quicksign"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:50052",
    "basePath": "/",
    "paths": {
        "/api/v1/sign/json": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Signs a structured JSON payload using JWS Compact Serialization (RFC 7515).\nSupports RS256 (RSA-2048) and ES256 (ECDSA-P256). The document code is embedded\nin the JWT Header `jti` claim for later verification.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Signing"
                ],
                "summary": "Sign a JSON payload",
                "parameters": [
                    {
                        "description": "JSON payload and optional certificate selection",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.signJsonRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "JWS compact token and document metadata",
                        "schema": {
                            "$ref": "#/definitions/http.signJsonResponse"
                        },
                        "headers": {
                            "X-Document-Code": {
                                "type": "string",
                                "description": "Generated document tracking code"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request body or empty payload",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Authentication required",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Active signing certificate not found",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Certificate revoked or expired at time of signing",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal signing error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/sign/pdf": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Upload a PDF file for digital signing using PAdES-BES (ISO 32000-1). A visual QR code\nappearance is embedded at the bottom of the first page, and the document code is stored\nin PKCS#9 Signed Attributes for later verification.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/pdf"
                ],
                "tags": [
                    "Signing"
                ],
                "summary": "Sign a PDF document",
                "parameters": [
                    {
                        "type": "file",
                        "description": "PDF file to sign (max 25 MB)",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Certificate UUID to use. If omitted, the user's active certificate is selected automatically.",
                        "name": "certificateId",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Reason for signing (embedded in the signature dictionary)",
                        "name": "reason",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Location of signing (embedded in the signature dictionary)",
                        "name": "location",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Signed PDF file",
                        "schema": {
                            "type": "file"
                        },
                        "headers": {
                            "X-Document-Code": {
                                "type": "string",
                                "description": "Generated document tracking code (e.g. DOC-2026-6AB19FD9)"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid PDF or missing required fields",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Authentication required",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Active signing certificate not found",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Certificate revoked or expired at time of signing",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal signing error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/verify/code/{documentCode}": {
            "get": {
                "description": "Looks up a document by its tracking code (scanned from the QR printed on the document).\nReturns `CODE_EXISTS_UNVERIFIED_CONTENT` per ADR 0001 §6 (Security Illusion Prevention):\nthe caller is informed the code exists but is **not** guaranteed the content is intact.\nThe user must upload the original file to `/api/v1/verify/file` for full content verification.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Verification"
                ],
                "summary": "Public QR code lookup",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Document code embedded in the QR (e.g. DOC-2026-6AB19FD9)",
                        "name": "documentCode",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Code exists — verification warning included",
                        "schema": {
                            "$ref": "#/definitions/domain.VerifyResult"
                        }
                    },
                    "400": {
                        "description": "Missing or empty document code",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Document code not found in the system",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/verify/file": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Verifies the cryptographic integrity of an uploaded PDF (PAdES) or JWS token.\nAccepts two content types:\n- **multipart/form-data** with field `file` for PDF files.\n- **application/json** with field `jws` containing a compact JWS string.\n\nThe service extracts the embedded signature, re-computes the hash, compares against\nthe stored original hash, and checks the certificate validity at signing time.\nAny content modification (even 1 byte) returns `TAMPERED_CONTENT`.",
                "consumes": [
                    "multipart/form-data",
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Verification"
                ],
                "summary": "Verify a signed document",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Signed PDF file (multipart/form-data)",
                        "name": "file",
                        "in": "formData"
                    },
                    {
                        "description": "JWS token wrapper (application/json)",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/http.verifyJwsRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Verification result",
                        "schema": {
                            "$ref": "#/definitions/domain.VerifyResult"
                        }
                    },
                    "400": {
                        "description": "Empty or unreadable payload",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal verification error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns service health status and timestamp",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "healthy",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.ValidationStatus": {
            "type": "string",
            "enum": [
                "VALID",
                "TAMPERED_CONTENT",
                "CERT_REVOKED",
                "CERT_EXPIRED_AT_SIGNING",
                "UNKNOWN_SIGNATURE",
                "CODE_EXISTS_UNVERIFIED_CONTENT"
            ],
            "x-enum-varnames": [
                "StatusValid",
                "StatusTamperedContent",
                "StatusCertRevoked",
                "StatusCertExpiredAtSigning",
                "StatusUnknownSignature",
                "StatusCodeExistsUnverified"
            ]
        },
        "domain.VerifyResult": {
            "type": "object",
            "properties": {
                "documentCode": {
                    "type": "string"
                },
                "documentName": {
                    "type": "string"
                },
                "isValid": {
                    "type": "boolean"
                },
                "revocationChecked": {
                    "type": "boolean"
                },
                "sha256Hash": {
                    "type": "string"
                },
                "signerSubject": {
                    "type": "string"
                },
                "signingTime": {
                    "type": "string"
                },
                "validationStatus": {
                    "$ref": "#/definitions/domain.ValidationStatus"
                },
                "verificationWarning": {
                    "type": "string"
                }
            }
        },
        "http.ErrorResponse": {
            "type": "object",
            "properties": {
                "details": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "errorCode": {
                    "type": "string"
                },
                "httpStatus": {
                    "type": "integer"
                },
                "message": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                },
                "traceId": {
                    "type": "string"
                }
            }
        },
        "http.signJsonRequest": {
            "type": "object",
            "properties": {
                "certificateId": {
                    "type": "string"
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": {}
                }
            }
        },
        "http.signJsonResponse": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "documentCode": {
                    "type": "string"
                },
                "jws": {
                    "type": "string"
                },
                "payloadHash": {
                    "type": "string"
                }
            }
        },
        "http.verifyJwsRequest": {
            "type": "object",
            "properties": {
                "jws": {
                    "description": "JWS compact serialization token (header.payload.signature)",
                    "type": "string",
                    "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpPU0UiLCJqdGkiOiJET0MtMjAyNi02QUIxOUZEOSJ9.eyJpbnZvaWNlTnVtYmVyIjoiSU5WLTIwMjYtOTk5OSIsImFtb3VudCI6MTI1MDAwMDB9.signature"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "QuickSign API Key — format: \"qs_live_{32-hex-bytes}\"",
            "type": "apiKey",
            "name": "X-API-Key",
            "in": "header"
        },
        "BearerAuth": {
            "description": "JWT Bearer token from QuickBite Identity — format: \"Bearer {token}\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "tags": [
        {
            "description": "Endpoints for signing PDF and JSON documents",
            "name": "Signing"
        },
        {
            "description": "Endpoints for verifying document integrity and QR code lookup",
            "name": "Verification"
        },
        {
            "description": "Service health probe",
            "name": "Health"
        }
    ]
}