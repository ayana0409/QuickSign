APP_ENV=development

# QuickSign Crypto Engine Configuration
GRPC_PORT=50051
HTTP_PORT=50052

# HashiCorp Vault Connection
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=your-vault-token-here
VAULT_KV_MOUNT=secret
VAULT_PATH_PREFIX=quicksign/users

# PostgreSQL Connection (host=... port=... dbname=... user=... password=... sslmode=disable or postgres://...)
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/quicksign?sslmode=disable

# Redis Connection
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# SSO Identity Authority
SSO_AUTHORITY=https://identity.example.com
WEB_PORTAL_URL=http://localhost:3000
